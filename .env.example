# Karzoun Media Factory environment
# Copy this file to .env. Never commit the real .env file.

# Core local runtime
POSTGRES_PASSWORD=
DATABASE_URL=
KMF_PORT=3100
APP_BASE_URL=http://localhost:3100
APP_SECRET=
SEED_DEMO_DATA=false

# Telegram remote control
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# AI engine / creative director
# Recommended zero-cost bridge: Groq Free Tier.
# GPT-OSS 120B handles creative planning; Qwen 3.6 27B is the default
# remote-MCP bridge because it has strong tool-use support on Groq.
# OpenAI and Anthropic remain optional fallbacks.
AI_PROVIDER=groq
CREATIVE_DIRECTOR=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MCP_MODEL=qwen/qwen3.6-27b
# Optional advanced overrides. Leave blank for the factory's automatic safe values.
GROQ_MCP_MAX_OUTPUT_TOKENS=
GROQ_MCP_REQUEST_OUTPUT_CAP=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Video generation
VIDEO_PROVIDER=mock
ALLOW_PAID_GENERATION=false
ALLOW_AUTOPILOT_PAID_GENERATION=false
OPENART_MCP_URL=https://mcp.openart.ai/mcp
# Prefer the encrypted durable OpenArt OAuth credential imported from MCP Inspector.
# These env values remain bootstrap fallbacks only.
OPENART_MCP_ACCESS_TOKEN=
OPENART_MCP_REFRESH_TOKEN=
OPENART_MCP_CLIENT_ID=
OPENART_MCP_CLIENT_SECRET=
OPENART_MCP_TOKEN_ENDPOINT=
OPENART_MCP_SCOPE=
OPENART_MCP_TOKEN_ENDPOINT_AUTH_METHOD=
# Optional comma-separated exact OpenArt MCP tool names. Leave blank to auto-discover
# and narrow the catalog to generation/status tools before each Groq render.
OPENART_MCP_ALLOWED_TOOLS=
VIDEO_MODEL_HINT=
REMOTE_MEDIA_ALLOWED_HOSTS=

# YouTube publishing
PUBLISHING_PROVIDER=mock
ALLOW_YOUTUBE_UPLOAD=false
ALLOW_PUBLIC_PUBLISHING=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
ANALYTICS_SYNC_MINUTES=30
