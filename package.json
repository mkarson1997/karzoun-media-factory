{
  "name": "karzoun-media-factory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "doctor": "tsx scripts/doctor.ts",
    "preflight": "tsx scripts/preflight.ts",
    "smoke:mock": "tsx scripts/smoke-mock.ts",
    "verify:mock": "npm run validate && npm run smoke:mock",
    "worker": "tsx src/worker.ts",
    "prompts:generate": "tsx scripts/generate-prompt-bank.ts",
    "prompts:bootstrap": "npm run prompts:generate && npm run import:prompts -- ./data/Karzoun_Media_Lab_1000_Shorts_Prompts.csv",
    "import:prompts": "tsx scripts/import-prompts.ts",
    "demo:cleanup": "tsx scripts/cleanup-demo.ts",
    "seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.117.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@prisma/client": "6.14.0",
    "csv-parse": "6.1.0",
    "googleapis": "176.0.0",
    "next": "15.5.21",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "telegraf": "4.16.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.34.0",
    "eslint-config-next": "15.5.21",
    "prisma": "6.14.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
